# =============================================================================
# Mad Mojo — environment variables
# Copy to .env.local for local dev. On Vercel, add the same keys in Project → Settings → Environment Variables.
# =============================================================================

# Site
NEXT_PUBLIC_SITE_URL=https://madmojo.shop

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (Dashboard → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Shippo (optional — shipping rates; falls back to flat estimates without it)
SHIPPO_API_KEY=

# Ship-from address (defaults to Krakow if unset)
SHIP_FROM_STREET=Rynek 1
SHIP_FROM_CITY=Krakow
SHIP_FROM_ZIP=31-042
SHIP_FROM_COUNTRY=PL
